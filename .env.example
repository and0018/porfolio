# Senha do painel administrativo (/admin). Troque antes de publicar.
ADMIN_PASSWORD=troque-esta-senha

# Segredo para assinar a sessão do admin. Gere um valor longo e aleatório.
# Ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Porta do servidor (o Render/Railway define automaticamente).
PORT=3000

# URL pública do site (usada em metatags, Open Graph e JSON-LD).
# Ex.: https://viniciusalmeida.com
SITE_URL=

# Pasta persistente de dados e uploads (opcional).
# Em produção com disco persistente, aponte para o disco montado.
# DATA_DIR=/var/data
# UPLOAD_DIR=/var/data/uploads

# NODE_ENV=production
